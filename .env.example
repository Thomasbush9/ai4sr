# Database Configuration
DB_PATH=data/review.db

# OpenAlex API Configuration
OPENALEX_EMAIL=your-email@example.com
MAX_CITATIONS_BACKWARD=10
MAX_CITATIONS_FORWARD=10
MAX_SIMILAR_PAPERS=10

# Semantic Scholar API Configuration (Optional)
SEMANTIC_SCHOLAR_API_KEY=

# Corpus Generation Limits
MAX_PUBMED_RESULTS_PER_REVIEW=2000
MAX_OPENALEX_RESULTS_PER_REVIEW=2000

# Azure AI Projects Configuration
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_AGENT_NAME=ai4sr-agent

# Azure Service Principal (for server authentication - choose ONE option):
# Option 1: Service Principal credentials (recommended for production)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Option 2: Use 'az login' for local development (no env vars needed)

# Additional Azure metadata (optional)
AZURE_ENV_NAME=
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=
AZURE_EXISTING_AIPROJECT_RESOURCE_ID=
AZURE_EXISTING_RESOURCE_ID=
AZURE_EXISTING_AGENT_ID=

# Microsoft Authentication (Entra ID)
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=your-secret-key-change-in-production
