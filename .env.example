# Database Configuration
DB_PATH=data/review.db

# OpenAlex API Configuration
OPENALEX_EMAIL=your-email@example.com
MAX_CITATIONS_BACKWARD=10
MAX_CITATIONS_FORWARD=10
MAX_SIMILAR_PAPERS=10

# Semantic Scholar API Configuration (Optional)
SEMANTIC_SCHOLAR_API_KEY=

# Corpus Generation Limits
MAX_PUBMED_RESULTS_PER_REVIEW=2000
MAX_OPENALEX_RESULTS_PER_REVIEW=2000

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# Microsoft Authentication (Entra ID)
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=your-secret-key-change-in-production
