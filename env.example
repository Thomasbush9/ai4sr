# AI4SR Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (Optional - only if not using Azure)
# Get your API key from https://platform.openai.com/api-keys
# If using Azure, set AZURE_EXISTING_AIPROJECT_ENDPOINT instead
OPENAI_KEY=

# Flask Configuration (Optional - defaults shown)
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=False
FLASK_ENV=development
# In production, FLASK_SECRET_KEY is REQUIRED
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Database Configuration (Optional - defaults shown)
DB_PATH=data/review.db

# Logging Configuration (Optional)
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Azure AI Projects Configuration (Optional)
AZURE_EXISTING_AIPROJECT_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_AGENT_NAME=ai4sr-agent

# Microsoft Authentication (Optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:5001/auth/callback

# OpenAlex API Configuration (Optional)
OPENALEX_EMAIL=noreply@example.com
MAX_CITATIONS_BACKWARD=10
MAX_CITATIONS_FORWARD=10
MAX_SIMILAR_PAPERS=10

# Semantic Scholar API (Optional)
SEMANTIC_SCHOLAR_API_KEY=

# Corpus Generation Limits (Server-side)
MAX_PUBMED_RESULTS_PER_REVIEW=2000
MAX_OPENALEX_RESULTS_PER_REVIEW=2000

